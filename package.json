{
  "name": "gcsc-platform",
  "version": "0.1.0",
  "private": true,
  "description": "GCSC three-repository migration candidate; not a production release",
  "scripts": {
    "test": "node --test tests/migration.test.mjs tests/source-provenance.test.mjs tests/legacy-preservation.test.mjs",
    "test:legacy-preservation": "node --test tests/legacy-preservation.test.mjs",
    "test:wallet-sdk": "node --test tests/wallet-sdk-identity.test.mjs",
    "test:wallet-payload": "node --test tests/wallet-challenge-payload.test.mjs",
    "check:api-syntax": "node --check services/api/v3/pure-server.js",
    "check:web": "node scripts/check-web.mjs",
    "check:integration-contracts": "node scripts/check-api-contracts.mjs",
    "build:web": "npm --prefix apps/web run build",
    "lint:web": "npm --prefix apps/web run lint",
    "test:api": "node scripts/run-api-tests.mjs",
    "check": "npm test && npm run test:wallet-restore && npm run check:api-syntax && npm run check:web",
    "test:source-history": "node --test tests/source-history.test.mjs",
    "test:api-config": "node --test tests/api-config.test.mjs",
    "test:wallet-restore": "node --test tests/wallet-restore.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
